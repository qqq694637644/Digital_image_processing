{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "A00: Debug Image Inspector",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/labs/A00_image_inspector/main.py",
            "cwd": "${workspaceFolder}/labs/A00_image_inspector",
            "console": "integratedTerminal",
            "args": [
                "${input:imagePath}"
            ]
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "imagePath",
            "type": "promptString",
            "description": "输入要读取的图片路径（相对于 labs/A00_image_inspector）",
            "default": "data/test.jpg"
        }
    ]
}
